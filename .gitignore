**/__pycache__/**
*.h5
.venv/
results/
results_dae/
results_geometry/
docs/_build/
docs/_generated/
orpheus/derivations/_richardson_cache.json

# Sood-registry solver-output cache (local-machine state, never committed)
.cache/
tools/research/elsevier.toml
matlab_archive/
orpheus.egg-info/

# Claude Code
.claude/settings.local.json
student_resources/*_results/

# Machine-generated by .claude/hooks/regen-pyrightconfig.sh (per-worktree
# pyright executionEnvironments); pyproject.toml [tool.pyright] is the
# committed base config
pyrightconfig.json

# OS cruft
.DS_Store
**/.DS_Store

# System-dependent container config
.devcontainer/

# Secrets — API keys live here, never committed
.env

# The nexus graph STORE. `.nexus/` is tracked because config.toml and
# ontology.toml are INPUTS; these three are not. Listed separately rather
# than ignoring `.nexus/*` so that adding a new tracked input needs no
# un-ignore, and so the split between input and artefact stays legible.
#
#   graph.db / graph.json — derived, rewritten by every `sphinx-build`
#   traces/               — DURABLE: an ingested runtime overlay costs
#                           minutes of profiled test run to reproduce, which
#                           is why it lives here and not in the build tree
#                           that `rm -rf docs/_build` empties
.nexus/graph.db
.nexus/graph.json
.nexus/traces/

# coverage.py's data file. Produced at the repo root by any `coverage run`,
# including the runs that feed `nexus runtime-ingest --kind coverage`.
.coverage
.coverage.*

# Local literature corpus (~215 MB of copyrighted PDFs + their OCR sidecars).
# The user maintains this locally; it is a read surface, never a deliverable.
# Ignored so `git add -A` cannot pull it into the index.
scratch/literature/
scratch/literature_ocr/
